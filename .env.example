# Copy to .env.local (gitignored) and fill in what you need. Shell variables win over this file.

# Claude API key for the app. Or put it in the key file below instead.
MATTER_COCKPIT_API_KEY=
# File holding the key (default shown). Keep it mode 600, outside the repo.
MATTER_COCKPIT_API_KEY_FILE=~/.config/matter-cockpit/api-key
# Model for intake calls.
MATTER_COCKPIT_MODEL=claude-sonnet-5-5
# Extra host names the dev server accepts, comma-separated (e.g. a tailscale serve MagicDNS name).
MATTER_COCKPIT_ALLOWED_HOSTS=
# Bind address and port. Keep 127.0.0.1: the API has no login and spends your key.
HOST=127.0.0.1
PORT=8982

# Optional comma-separated absolute directories of local PDF + .extraction.json order pairs for keyless replay.
MATTER_COCKPIT_EXTRA_ORDERS_DIR=

# Optional USPTO Open Data Portal key for the Prior art tab (or ~/.config/matter-cockpit/uspto-key)
MATTER_COCKPIT_USPTO_KEY=

# Waiting-on client notifications. Leave all four unset for the demo: every message is then a preview.
# Synthetic recipients (example.invalid, 555-01xx) never send, even when configured.
# Resend API key for email (or put it in ~/.config/matter-cockpit/resend-key).
MATTER_COCKPIT_RESEND_KEY=
# Verified sender address for Resend email.
MATTER_COCKPIT_EMAIL_FROM=
# Telnyx API key for text messages (or put it in ~/.config/matter-cockpit/telnyx-key).
MATTER_COCKPIT_TELNYX_KEY=
# Telnyx sender number, E.164, such as +16125550000.
MATTER_COCKPIT_SMS_FROM=
